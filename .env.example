PORT=5000

# Existing MySQL connection (used by location routes, not by Visko Chat)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Visko Chat
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/viskochat?retryWrites=true&w=majority
JWT_SECRET=
CHAT_MAX_FILE_MB=50
CORS_ORIGIN=https://your-crm-frontend.example.com
